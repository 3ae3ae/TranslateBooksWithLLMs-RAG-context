# TBL configuration (optional). Save as .env in the app's data folder
# (macOS: ~/Library/Application Support/TBL, Linux: ~/.local/share/tbl,
# Windows: %APPDATA%\TBL, or $TBL_HOME) and uncomment what you need.
# A .env in the folder you run tbl from is ignored.
#
# The app keeps its own settings in that folder (model connections,
# new-translation defaults) and you edit them in Settings.
# This file is only for:
#   - server settings (port, output folder, debug logging)
#   - a one-time import, the first time the app starts: API keys into model
#     connections, and the values below into the new-translation defaults
#   - low-level tuning that has no setting in the app

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# PORT=5000
# OUTPUT_DIR=~/Documents/Translations
# DEBUG_MODE=false

# -----------------------------------------------------------------------------
# Imported into model connections once, when connections.json doesn't exist yet.
# See docs/MODEL_CONNECTIONS.md.
# -----------------------------------------------------------------------------
# Service that becomes the default: ollama, openai, gemini, openrouter,
# mistral, deepseek, poe, nim
# LLM_PROVIDER=ollama
# DEFAULT_MODEL=qwen3:14b
# OLLAMA_API_ENDPOINT=http://localhost:11434/api/generate
# An address other than api.openai.com becomes an OpenAI-compatible connection.
# OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# Several comma-separated keys become several keys in one connection.
# OPENAI_API_KEY=sk-xxxxxxxx
# GEMINI_API_KEY=YOUR_API_KEY_HERE
# OPENROUTER_API_KEY=YOUR_API_KEY_HERE
# NEURALWATT_API_KEY=YOUR_API_KEY_HERE
# OLLAMA_API_KEY=YOUR_API_KEY_HERE      # Ollama Cloud
# MISTRAL_API_KEY=YOUR_API_KEY_HERE
# DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
# POE_API_KEY=YOUR_API_KEY_HERE
# NIM_API_KEY=YOUR_API_KEY_HERE

# Default model per service (optional), e.g. GEMINI_MODEL, OPENROUTER_MODEL,
# NEURALWATT_MODEL, OLLAMA_MODEL, MISTRAL_MODEL, DEEPSEEK_MODEL, POE_MODEL, NIM_MODEL
# GEMINI_MODEL=

# -----------------------------------------------------------------------------
# New-translation defaults, copied once when settings.json is first created
# -----------------------------------------------------------------------------
# DEFAULT_SOURCE_LANGUAGE=
# DEFAULT_TARGET_LANGUAGE=
# MAX_TOKENS_PER_CHUNK=450
# SRT_LINES_PER_BLOCK=10
# OUTPUT_FILENAME_PATTERN={originalName} ({targetLang}).{ext}
# NOVEL_CONTEXT_PROMPT_MAX_TOKENS=1800
# NOVEL_CONTEXT_SOURCE_MEMORY_CHARS=6000
# NOVEL_CONTEXT_CONSOLIDATION_INTERVAL=5

# -----------------------------------------------------------------------------
# Low-level tuning
# -----------------------------------------------------------------------------
# Ollama context window. With AUTO_ADJUST_CONTEXT the app starts smaller and
# grows it when a request needs more.
# OLLAMA_NUM_CTX=4096
# AUTO_ADJUST_CONTEXT=true

# Gemini safety filter. BLOCK_NONE avoids silently empty answers on adult
# fiction. Other values: BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE.
# GEMINI_SAFETY_THRESHOLD=BLOCK_NONE
