# TBL configuration (optional). Copy to .env and uncomment what you need.
#
# The web app keeps its own settings in TranslateBook_Data/ (model connections,
# new-translation defaults, notifications) and edits them in Settings.
# This file is for:
#   - server settings (port, output folder, debug logging)
#   - the command-line tool, translate.py
#   - a one-time import of API keys into model connections and of defaults into
#     settings, the first time the web app starts
#   - low-level tuning that has no setting in the app

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# PORT=5000
# OUTPUT_DIR=translated_files
# DEBUG_MODE=false

# -----------------------------------------------------------------------------
# Models: used by the CLI, and imported into connections on the first web start
# -----------------------------------------------------------------------------
# CLI provider: ollama, openai, gemini, openrouter, mistral, deepseek, poe, nim
# LLM_PROVIDER=ollama
# DEFAULT_MODEL=qwen3:14b
# OLLAMA_API_ENDPOINT=http://localhost:11434/api/generate
# CLI endpoint for --provider ollama or openai (LM Studio, llama.cpp, vLLM, ...)
# API_ENDPOINT=http://localhost:11434/api/generate
# OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# Keys. Several comma-separated keys rotate when one hits a rate limit.
# OPENAI_API_KEY=sk-xxxxxxxx
# GEMINI_API_KEY=YOUR_API_KEY_HERE
# OPENROUTER_API_KEY=YOUR_API_KEY_HERE
# MISTRAL_API_KEY=YOUR_API_KEY_HERE
# DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
# POE_API_KEY=YOUR_API_KEY_HERE
# NIM_API_KEY=YOUR_API_KEY_HERE
# Imported into web connections only (no CLI provider):
# NEURALWATT_API_KEY=YOUR_API_KEY_HERE
# OLLAMA_API_KEY=YOUR_API_KEY_HERE      # Ollama Cloud

# Per-service default models (optional)
# GEMINI_MODEL=
# OPENROUTER_MODEL=
# MISTRAL_MODEL=
# DEEPSEEK_MODEL=
# POE_MODEL=
# NIM_MODEL=

# -----------------------------------------------------------------------------
# CLI translation settings (the web app sets these per translation)
# -----------------------------------------------------------------------------
# DEFAULT_SOURCE_LANGUAGE=
# DEFAULT_TARGET_LANGUAGE=
# PARALLEL_TRANSLATIONS=1
# MAX_TOKENS_PER_CHUNK=450
# SRT_LINES_PER_BLOCK=10
# OUTPUT_FILENAME_PATTERN={originalName} ({targetLang}).{ext}
# REQUEST_TIMEOUT=300
# MAX_TRANSLATION_ATTEMPTS=2
# TEMPERATURE=0.3

# Story notes (CLI; also the first web defaults)
# NOVEL_CONTEXT_PROMPT_MAX_TOKENS=1800
# NOVEL_CONTEXT_UPDATE_INTERVAL=1
# NOVEL_CONTEXT_SOURCE_MEMORY_CHARS=6000
# NOVEL_CONTEXT_CONSOLIDATION_INTERVAL=5

# -----------------------------------------------------------------------------
# Low-level tuning (web app and CLI)
# -----------------------------------------------------------------------------
# Ollama context window. With AUTO_ADJUST_CONTEXT the app starts smaller and
# grows it when a request needs more.
# OLLAMA_NUM_CTX=4096
# AUTO_ADJUST_CONTEXT=true

# Gemini safety filter. BLOCK_NONE avoids silently empty answers on adult
# fiction. Other values: BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE.
# GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

# -----------------------------------------------------------------------------
# Notifications: copied into the web settings once, when they are first created.
# See docs/NOTIFICATIONS.md.
# -----------------------------------------------------------------------------
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-unique-topic
# NOTIFY_WEBHOOK_METHOD=POST
# NOTIFY_WEBHOOK_HEADERS=
# NOTIFY_WEBHOOK_PAYLOAD=
# NOTIFY_ON_SUCCESS=true
# NOTIFY_ON_FAILURE=true
# NOTIFY_ON_INTERRUPTION=false
# NOTIFY_TIMEOUT_SECONDS=5
